# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
GLOBAL_PREFIX=api
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:4000

# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: both can be the same direct connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/novabulletin
# Production (Supabase): DATABASE_URL = pooled URL, DIRECT_URL = direct URL
DIRECT_URL=postgresql://postgres:password@localhost:5432/novabulletin

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOADS_DIR=uploads

# ─── Email (choose one provider) ─────────────────────────────────────────────
MAIL_FROM=noreply@yourschool.tg

# Option A — SendGrid (takes priority if key is set)
SENDGRID_API_KEY=your_sendgrid_key

# Option B — SMTP (Mailtrap, Gmail, etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token

# ─── Redis (BullMQ — future queue use) ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Platform subscription (schools paying NovaBulletin) ─────────────────────
# Tiers are auto-detected from student count:
#   STARTER < 50 | BASIC 50-99 | PRO 100-199 | ENTERPRISE 200+
SUBSCRIPTION_STARTER_MONTHLY_XOF=5000
SUBSCRIPTION_STARTER_ANNUAL_XOF=50000
SUBSCRIPTION_BASIC_MONTHLY_XOF=10000
SUBSCRIPTION_BASIC_ANNUAL_XOF=100000
SUBSCRIPTION_PRO_MONTHLY_XOF=20000
SUBSCRIPTION_PRO_ANNUAL_XOF=200000
SUBSCRIPTION_ENTERPRISE_MONTHLY_XOF=35000
SUBSCRIPTION_ENTERPRISE_ANNUAL_XOF=350000
OWNER_MOMO_NUMBER=+228XXXXXXXX
OWNER_MOMO_OPERATOR=TMoney
SUBSCRIPTION_TRIAL_DAYS=30
