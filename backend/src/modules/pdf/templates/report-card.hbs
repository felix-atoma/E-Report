<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
{{!--
  Bulletin PDF — copie conforme de la page d'impression web
  (frontend/src/pages/shared/PrintReportCardPage : même structure, mêmes classes, même CSS).
  Toute modification de la page web doit être reportée ici, et inversement.
--}}
{{#if theme.googleFontUrl}}<link rel="stylesheet" href="{{theme.googleFontUrl}}" />{{/if}}
<style>
:root {
  --bulletin-primary: {{theme.primary}};
  --bulletin-secondary: {{theme.secondary}};
  --bulletin-font-family: {{{theme.fontFamily}}};
  --bulletin-font-size: {{theme.fontSize}};
  --bulletin-h1-size: {{theme.h1Size}};
  --bulletin-h1-weight: {{theme.h1Weight}};
  --bulletin-h2-size: {{theme.h2Size}};
  --bulletin-h2-weight: {{theme.h2Weight}};
  --bulletin-h3-size: {{theme.h3Size}};
  --bulletin-h3-weight: {{theme.h3Weight}};
}
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: #fff; }
body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
@page { size: A4; margin: 0; }

/* ── Feuille A4 (identique à .print-page__a4 en impression) ── */
.print-page__a4 {
  width: 210mm;
  height: 297mm;
  margin: 0;
  padding: 6mm 9mm 5mm;
  background: #fff;
  font-family: var(--bulletin-font-family, Arial, Helvetica, sans-serif);
  font-size: var(--bulletin-font-size, 11.5px);
  font-weight: 700;
  color: #111;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 0;
  page-break-inside: avoid; break-inside: avoid;
}

/* ── Filigrane ── */
.pr-watermark {
  position: absolute; top: 50%; left: 50%; width: 92%;
  transform: translate(-50%, -50%) rotate(-35deg);
  pointer-events: none; user-select: none;
  z-index: 50; overflow: visible;
  mix-blend-mode: multiply;
}
.pr-watermark__text {
  font-family: 'Arial Black', Arial, Helvetica, sans-serif;
  font-weight: 900;
  fill: var(--bulletin-primary); fill-opacity: 0.10;
  stroke: var(--bulletin-primary); stroke-opacity: 0.12; stroke-width: 1.5px;
  paint-order: stroke;
  letter-spacing: 3px;
}

/* ── Ajustement à une page (--fit calculé par le script en bas de page) ── */
.print-page__fit {
  display: flex; flex-direction: column; flex: none;
  width: calc(100% / var(--fit, 1));
  height: calc(100% / var(--fit, 1));
  transform: scale(var(--fit, 1));
  transform-origin: top left;
}

/* ── En-tête ── */
.prh { position: relative; margin-bottom: 6px; }
.prh__country {
  display: flex; justify-content: space-between; gap: 10px;
  font-size: 0.85em; color: #4b5563; text-transform: uppercase; letter-spacing: 0.5px;
  border-bottom: 1px solid #e5e7eb; padding-bottom: 3px; margin-bottom: 4px;
}
.prh__name {
  text-align: center; font-size: 2.1em; font-weight: 900; line-height: 1.15;
  color: var(--bulletin-primary); text-transform: uppercase; letter-spacing: 1px;
  margin-bottom: 6px;
}
.prh__body { display: flex; align-items: center; gap: 12px; }
.prh__logo { width: 78px; height: 78px; object-fit: contain; flex-shrink: 0; }
.prh__contacts { flex: 1; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 3px; }
.prh__contacts li { display: flex; align-items: center; gap: 7px; font-size: 1.05em; color: #1f2937; }
.prh__ico {
  width: 16px; height: 16px; flex-shrink: 0; border-radius: 50%;
  background: var(--bulletin-primary);
  display: inline-flex; align-items: center; justify-content: center;
}
.prh__ico svg { width: 9px; height: 9px; fill: #fff; }
.prh__motto { font-style: italic; font-weight: 700; color: var(--bulletin-primary); }
.prh__verify { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 2px; align-self: flex-end; }
.prh__qr { width: 64px; height: 64px; display: block; image-rendering: pixelated; }
.prh__serial { font-size: 0.75em; color: #6b7280; letter-spacing: 0.3px; white-space: nowrap; }
.prh__photo {
  width: 70px; height: 84px; flex-shrink: 0; overflow: hidden; border-radius: 3px;
  border: 2px solid var(--bulletin-primary); background: #f3f4f6;
  display: flex; align-items: center; justify-content: center;
}
.prh__photo img { width: 100%; height: 100%; object-fit: cover; }
.prh__photo svg { width: 44px; height: 44px; fill: #cbd5e1; }

.prh__banner {
  background: var(--bulletin-primary); color: #fff; text-align: center;
  font-size: 1.25em; font-weight: 800; letter-spacing: 1.5px;
  padding: 5px 10px; margin: 8px 0 6px; border-radius: 3px;
}
.prh__banner-term { text-transform: none; }

.prh__info { width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 1.05em; }
.prh__info td { padding: 2.5px 4px; vertical-align: top; border: none; }
.prh__lbl { font-weight: 700; color: #111827; white-space: nowrap; width: 19%; }
.prh__sep { width: 8px; font-weight: 700; }
.prh__val { font-weight: 700; color: var(--bulletin-primary); width: 31%; }
.prh__val--strong { color: #dc2626; font-size: 1.1em; font-weight: 900; }  /* Rang et moyenne générale en rouge */
.prh__val--fail { color: #dc2626; }

/* ── Tableau des notes ── */
.pr-grades-wrap { flex: 1; min-height: 0; overflow: hidden; margin-bottom: 4px; position: relative; }
.pr-grades { width: 100%; height: 100%; border-collapse: collapse; font-size: 1em; font-weight: 800; }
.pr-grades th {
  border: 1px solid #9ca3af; padding: 0 2px;
  text-align: center; vertical-align: middle; font-weight: 800;
}
.pr-grades td {
  border-top: 1px solid #6b7280; border-bottom: 1px solid #6b7280;
  border-left: 1px solid #d1d5db; border-right: 1px solid #d1d5db;
  padding: 1px 2px; text-align: center; vertical-align: middle; font-weight: 800;
}
.pr-grades tbody { height: 100%; }
.pr-grades tbody tr { height: 1px; }
.pr-grades tbody td { height: inherit; }
.pr-grades__head-top th {
  background: var(--bulletin-primary);
  color: #fff; font-size: 0.85em; font-weight: 900; padding: 3px 2px;
}
.pr-grades__head-sub th { background: #dbeafe; color: #1e40af; font-size: 0.8em; font-weight: 900; padding: 2px; }
.pr-grades__col-matiere { text-align: left !important; min-width: 84px; font-weight: 900; padding-left: 4px !important; }
.pr-grades__col-num  { min-width: 24px; }
.pr-grades__col-dev  { background: rgba(254,252,193,0.5); }
.pr-grades__col-cmp  { background: rgba(243,232,255,0.5); }
.pr-grades__col-moy  { background: #dcfce7; font-weight: 900; min-width: 28px; }
.pr-grades__col-pts  { background: #f0fdf4; font-weight: 800; }
.pr-grades__col-rang { color: #0f766e; font-weight: 900; min-width: 22px; }
.pr-grades__col-appr { text-align: left !important; min-width: 100px; width: 110px; font-size: 0.8em; font-weight: 800; padding-left: 3px !important; white-space: normal; word-break: break-word; }
.pr-grades__col-prof { text-align: left !important; min-width: 56px; font-size: 0.8em; font-weight: 800; padding-left: 3px !important; }
.pr-grades__col-sig  { min-width: 48px; width: 52px; padding: 1px 2px !important; }
.pr-grades__fail { color: #dc2626 !important; font-weight: 700; }
.pr-grades__pass { color: #15803d; }
.pr-grades tbody tr:nth-child(even) { background: #f9fafb; }
.pr-grades__foot td { background: var(--bulletin-primary); color: #fff; font-weight: 900; font-size: 1em; padding: 2px; }
.pr-grades__foot-label { text-align: right !important; padding-right: 5px !important; }
.pr-sig-img   { max-height: 22px; max-width: 58px; object-fit: contain; display: block; margin: 0 auto; }
.pr-sig-blank { width: 40px; height: 1px; background: #d1d5db; margin: 8px auto 6px; }
.pr-sig-verified { font-size: 0.75em; font-weight: 700; color: #15803d; }
.pr-grades--primary td, .pr-grades--primary th { font-size: 1.1em; padding-top: 5px; padding-bottom: 5px; }
.pr-grades--primary .pr-grades__col-moy { font-size: 1.2em; }

/* ── Résultats ── */
.pr-results { display: flex; flex-direction: column; gap: 3px; margin-bottom: 4px; flex-shrink: 0; }
.pr-results__section { width: 100%; border: 1.5px solid var(--bulletin-primary); border-radius: 3px; overflow: hidden; }
.pr-results__section-title {
  background: var(--bulletin-primary); color: #fff;
  font-size: var(--bulletin-h3-size, 0.8em); font-weight: var(--bulletin-h3-weight, 800);
  text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 6px; text-align: center;
}
.pr-results__cells { display: flex; flex-wrap: nowrap; }
.pr-results__cell { flex: 1; padding: 4px 4px; text-align: center; border-right: 1px solid #e5e7eb; }
.pr-results__cell:last-child { border-right: none; }
.pr-results__cell label {
  display: block; font-size: 0.7em; color: #555; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 1px;
}
.pr-results__cell strong { font-size: 1.35em; font-weight: 900; display: block; }
.pr-results__cell--big strong { font-size: 1.65em; font-weight: 900; }
.pr-results__cell--high strong { color: #15803d; }
.pr-results__cell--low  strong { color: #dc2626; }
.pr-results__cell--honor { background: #fef3c7; border-color: #fcd34d; display: flex; align-items: center; justify-content: center; }
.pr-results__cell--honor strong { font-size: 0.75em; color: #92400e; }
/* Moyenne générale, rang, mention, plus forte et plus faible moyenne : en rouge, bien visibles */
.pr-results__cell--red strong { color: #dc2626 !important; font-weight: 900; }
.pr-results__cell--red label { color: #991b1b; }
.pr-val--pass { color: #15803d; }
.pr-val--fail { color: #dc2626; }
.pr-val-denom { font-size: 0.75em; font-weight: 400; color: #6b7280; }

/* ── Moyenne annuelle + décision ── */
.pr-annual-bar { display: flex; border: 2px solid var(--bulletin-primary); border-radius: 3px; margin-bottom: 4px; flex-shrink: 0; overflow: hidden; }
.pr-annual-bar__cell { padding: 4px 8px; text-align: center; border-right: 1px solid #c7d0da; min-width: 80px; }
.pr-annual-bar__cell label { display: block; font-size: 0.7em; font-weight: 800; color: #555; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 1px; }
.pr-annual-bar__cell strong { font-size: 1.5em; font-weight: 900; display: block; }
.pr-annual-bar__decision { flex: 1; display: flex; align-items: center; gap: 6px; padding: 4px 12px; }
.pr-annual-bar__decision label { font-size: 0.75em; font-weight: 800; color: #555; text-transform: uppercase; letter-spacing: 0.3px; white-space: nowrap; }
.pr-annual-bar__decision strong { font-size: 1.3em; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px; }

/* ── Appréciations ── */
.pr-comments { display: flex; gap: 4px; margin-bottom: 4px; flex-shrink: 0; }
.pr-comment-box { flex: 1; border: 1px solid #d1d5db; border-radius: 3px; overflow: hidden; }
.pr-comment-box__label {
  background: #f3f4f6; font-size: 0.7em; font-weight: 800;
  text-transform: uppercase; color: var(--bulletin-primary);
  padding: 2px 5px; letter-spacing: 0.3px;
}
.pr-comment-box__text { padding: 2px 5px; font-size: 0.88em; font-weight: 700; font-style: italic; color: #374151; min-height: 16px; line-height: 1.4; }
.pr-comment-box__empty { display: block; height: 12px; }

/* ── Signatures ── */
.pr-signatures { display: flex; gap: 6px; margin-bottom: 3px; flex-shrink: 0; }
.pr-sig { flex: 1; text-align: center; }
.pr-sig__area { height: 22px; border: 1px dashed #d1d5db; border-radius: 3px; margin-bottom: 2px; background: #fafafa; }
.pr-sig__area--stamp { border: 1.5px dashed #9ca3af; border-radius: 50%; height: 28px; width: 28px; margin: 0 auto 2px; background: #f9fafb; }
.pr-sig__area--signed { height: 28px; border: none; background: none; display: flex; align-items: center; justify-content: center; }
.pr-sig__area--signed img { max-height: 28px; max-width: 100%; object-fit: contain; }
.pr-sig__line  { height: 1px; background: #374151; margin-bottom: 2px; }
.pr-sig__name  { font-size: 0.75em; font-weight: 800; color: var(--bulletin-primary); min-height: 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pr-sig__date  { font-size: 0.68em; color: #374151; min-height: 9px; }
.pr-sig__label { font-size: 0.7em; color: #555; font-style: italic; font-weight: 600; }
.pr-sig--stamp { flex: 0 0 auto; width: 44px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.pr-sig--visa  { border: 1px solid #d1d5db; border-radius: 4px; padding: 3px 5px; background: #fafafa; }
.pr-sig__label--stamp { margin-top: 2px; }

/* ── Pied de page ── */
.pr-footer {
  font-size: 0.8em; color: #9ca3af;
  border-top: 1.5px solid #e5e7eb; padding-top: 4px; flex-shrink: 0;
  display: flex; justify-content: space-between; align-items: center; gap: 8px;
}
.pr-footer__security {
  font-size: 1em; color: #374151; background: #f1f5f9; border: 1px solid #e2e8f0;
  padding: 1px 6px; border-radius: 4px; white-space: nowrap; letter-spacing: 0.04em;
}
.pr-footer__security strong { color: #1e3a8a; font-weight: 800; }
.pr-footer__verify-url { color: #2563eb; font-style: italic; }
</style>
</head>
<body>
<div class="print-page__a4">

  {{#if watermark}}
  <svg class="pr-watermark" aria-hidden="true" viewBox="0 0 700 {{watermark.height}}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
    {{#each watermark.lines}}
    <text x="350" y="{{this.y}}" text-anchor="middle" font-size="{{../watermark.fontSize}}" class="pr-watermark__text"{{#if this.fit}} textLength="680" lengthAdjust="spacingAndGlyphs"{{/if}}>{{this.text}}</text>
    {{/each}}
  </svg>
  {{/if}}

  <div class="print-page__fit">

  <!-- En-tête -->
  <div class="prh">
    {{#if institution.countryLine}}
    <div class="prh__country">
      <span>{{institution.countryLine}}</span>
      {{#if institution.circonscription}}<span>{{institution.circonscription}}</span>{{/if}}
    </div>
    {{else}}{{#if institution.circonscription}}
    <div class="prh__country"><span></span><span>{{institution.circonscription}}</span></div>
    {{/if}}{{/if}}
    <div class="prh__name">{{#if institution.name}}{{institution.name}}{{else}}Établissement scolaire{{/if}}</div>
    <div class="prh__body">
      {{#if institution.headerLogo}}<img src="{{institution.headerLogo}}" alt="Logo" class="prh__logo" />{{/if}}
      <ul class="prh__contacts">
        {{#if institution.phone}}<li><span class="prh__ico"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg></span>{{institution.phone}}</li>{{/if}}
        {{#if institution.address}}<li><span class="prh__ico"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg></span>{{institution.address}}</li>{{/if}}
        {{#if institution.email}}<li><span class="prh__ico"><svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z"/></svg></span>{{institution.email}}</li>{{/if}}
        {{#if institution.website}}<li><span class="prh__ico"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-2.9a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16zM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.3 6.7 8 8zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6zM16.3 14a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z"/></svg></span>{{institution.website}}</li>{{/if}}
        {{#if institution.motto}}<li><span class="prh__ico"><svg viewBox="0 0 24 24"><path d="M12 17.3 18.2 21l-1.6-7L22 9.2l-7.2-.6L12 2 9.2 8.6 2 9.2 7.5 14l-1.7 7z"/></svg></span><span class="prh__motto">{{institution.motto}}</span></li>{{/if}}
      </ul>
      <div class="prh__verify">
        {{#if qrDataUri}}<img src="{{qrDataUri}}" alt="Code de vérification" class="prh__qr" />{{/if}}
        <div class="prh__serial">N° {{serial}}</div>
      </div>
      <div class="prh__photo">
        {{#if student.photo}}<img src="{{student.photo}}" alt="Photo élève" />{{else}}<svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.3 0-9 2.2-9 5v3h18v-3c0-2.8-4.7-5-9-5z"/></svg>{{/if}}
      </div>
    </div>
  </div>

  <div class="prh__banner">BULLETIN DE NOTES — <span class="prh__banner-term">{{termLabel}}</span></div>

  <table class="prh__info">
    <tbody>
      <tr>
        <td class="prh__lbl">Nom et prénoms</td><td class="prh__sep">:</td><td class="prh__val">{{student.name}}</td>
        <td class="prh__lbl">N° Matricule</td><td class="prh__sep">:</td><td class="prh__val">{{#if student.admissionNumber}}{{student.admissionNumber}}{{else}}—{{/if}}</td>
      </tr>
      <tr>
        <td class="prh__lbl">Sexe</td><td class="prh__sep">:</td><td class="prh__val">{{student.sexLabel}}</td>
        <td class="prh__lbl">Date de naissance</td><td class="prh__sep">:</td><td class="prh__val">{{student.dateOfBirth}}</td>
      </tr>
      <tr>
        <td class="prh__lbl">Classe</td><td class="prh__sep">:</td><td class="prh__val">{{#if class.name}}{{class.name}}{{else}}—{{/if}}</td>
        <td class="prh__lbl">Effectif</td><td class="prh__sep">:</td><td class="prh__val">{{#if report.classSize}}{{report.classSize}} élèves{{else}}—{{/if}}</td>
      </tr>
      <tr>
        <td class="prh__lbl">Rang</td><td class="prh__sep">:</td>
        <td class="prh__val prh__val--strong">{{#if report.rankLabel}}{{report.rankLabel}}{{#if report.classSize}} / {{report.classSize}}{{/if}}{{else}}—{{/if}}</td>
        <td class="prh__lbl">Année scolaire</td><td class="prh__sep">:</td><td class="prh__val">{{#if report.academicYear}}{{report.academicYear}}{{else}}—{{/if}}</td>
      </tr>
      <tr>
        <td class="prh__lbl">Moyenne générale</td><td class="prh__sep">:</td>
        <td class="prh__val prh__val--strong{{#if averageFailing}} prh__val--fail{{/if}}">{{#if report.averageLabel}}{{report.averageLabel}} / {{scale.denom}}{{else}}—{{/if}}</td>
        <td class="prh__lbl">Période</td><td class="prh__sep">:</td><td class="prh__val">{{termLabel}}</td>
      </tr>
      <tr>
        <td class="prh__lbl">Mention</td><td class="prh__sep">:</td><td class="prh__val prh__val--strong">{{#if report.mention}}{{report.mention}}{{else}}—{{/if}}</td>
        <td class="prh__lbl">Conduite</td><td class="prh__sep">:</td><td class="prh__val">{{report.conductLabel}}</td>
      </tr>
    </tbody>
  </table>

  <!-- Tableau des notes -->
  <div class="pr-grades-wrap">
    {{#if isPrimary}}
    <table class="pr-grades pr-grades--primary">
      <thead>
        <tr class="pr-grades__head-top">
          <th class="pr-grades__col-num">N°</th>
          <th class="pr-grades__col-matiere">Matière</th>
          <th class="pr-grades__col-moy">Note</th>
          <th class="pr-grades__col-rang">Rang</th>
          <th class="pr-grades__col-appr">Appréciation</th>
        </tr>
      </thead>
      <tbody>
        {{#each grades}}
        <tr>
          <td class="pr-grades__col-num">{{inc @index}}</td>
          <td class="pr-grades__col-matiere">{{#if subject.nameFr}}{{subject.nameFr}}{{else}}—{{/if}}</td>
          <td class="pr-grades__col-moy{{#if this.passed}} pr-grades__pass{{else}} pr-grades__fail{{/if}}">{{this.noteLabel}}<span class="pr-val-denom"> / {{this.noteMax}}</span></td>
          <td class="pr-grades__col-rang">{{#if this.rangMatiere}}{{this.rangMatiere}}{{else}}—{{/if}}</td>
          <td class="pr-grades__col-appr">{{#if this.appreciation}}{{this.appreciation}}{{else}}—{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr class="pr-grades__foot">
          <td colspan="2" class="pr-grades__foot-label">TOTAL DES POINTS</td>
          <td>{{scale.primaryTotal}} / {{scale.primaryTotalMax}}</td>
          <td class="pr-grades__foot-label">MOYENNE</td>
          <td>{{scale.overallAverage}} / 10</td>
        </tr>
      </tfoot>
    </table>
    {{else}}
    <table class="pr-grades">
      <thead>
        <tr class="pr-grades__head-top">
          <th rowspan="2" class="pr-grades__col-matiere">Matière</th>
          <th colspan="2" class="pr-grades__group">Interrogations</th>
          <th rowspan="2" class="pr-grades__col-dev">Devoir</th>
          <th rowspan="2" class="pr-grades__col-cmp">Compo.</th>
          <th rowspan="2" class="pr-grades__col-moy">Moy.</th>
          <th rowspan="2" class="pr-grades__col-coef">Coef</th>
          <th rowspan="2" class="pr-grades__col-pts">Points</th>
          <th rowspan="2" class="pr-grades__col-rang">Rang</th>
          <th rowspan="2" class="pr-grades__col-appr">Appréciation</th>
          <th rowspan="2" class="pr-grades__col-prof">Nom du prof.</th>
          <th rowspan="2" class="pr-grades__col-sig">Signature</th>
        </tr>
        <tr class="pr-grades__head-sub">
          <th class="pr-grades__col-num">Interro 1</th>
          <th class="pr-grades__col-num">Interro 2</th>
        </tr>
      </thead>
      <tbody>
        {{#each grades}}
        <tr>
          <td class="pr-grades__col-matiere">{{#if subject.nameFr}}{{subject.nameFr}}{{else}}—{{/if}}</td>
          <td>{{fmtNote this.noteInterro1}}</td>
          <td>{{fmtNote this.noteInterro2}}</td>
          <td class="pr-grades__col-dev">{{fmtNote this.noteDevoir}}</td>
          <td class="pr-grades__col-cmp">{{fmtNote this.noteComposition}}</td>
          <td class="pr-grades__col-moy{{#if this.passed}} pr-grades__pass{{else}} pr-grades__fail{{/if}}">{{this.moyLabel}}</td>
          <td>{{this.coefficient}}</td>
          <td class="pr-grades__col-pts">{{fmtScore this.weightedScore}}</td>
          <td class="pr-grades__col-rang">{{#if this.rangMatiere}}{{this.rangMatiere}}{{else}}—{{/if}}</td>
          <td class="pr-grades__col-appr">{{#if this.appreciation}}{{this.appreciation}}{{else}}—{{/if}}</td>
          <td class="pr-grades__col-prof">{{#if this.teacherName}}{{this.teacherName}}{{else}}—{{/if}}</td>
          <td class="pr-grades__col-sig">
            {{#if this.adminVerified}}<span class="pr-sig-verified">✓</span>
            {{else}}{{#if this.signatureData}}<img src="{{this.signatureData}}" alt="" class="pr-sig-img" />
            {{else}}<div class="pr-sig-blank"></div>{{/if}}{{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr class="pr-grades__foot">
          <td colspan="6" class="pr-grades__foot-label">TOTAUX</td>
          <td>{{report.totalCoef}}</td>
          <td>{{totalPointsLabel}}</td>
          <td colspan="4"></td>
        </tr>
      </tfoot>
    </table>
    {{/if}}
  </div>

  <!-- Résultats -->
  <div class="pr-results">
    <div class="pr-results__section pr-results__section--student">
      <div class="pr-results__section-title">Résultats de l'élève</div>
      <div class="pr-results__cells">
        <div class="pr-results__cell pr-results__cell--big pr-results__cell--red">
          <label>Moyenne Générale</label>
          <strong class="{{#if report.isPassing}}pr-val--pass{{else}}pr-val--fail{{/if}}">{{scale.overallAverage}}<span class="pr-val-denom"> / {{scale.denom}}</span></strong>
        </div>
        {{#if isPrimary}}
        <div class="pr-results__cell">
          <label>Total des points</label>
          <strong>{{scale.primaryTotal}}<span class="pr-val-denom"> / {{scale.primaryTotalMax}}</span></strong>
        </div>
        {{/if}}
        <div class="pr-results__cell pr-results__cell--red">
          <label>Mention</label>
          <strong>{{#if report.mention}}{{report.mention}}{{else}}—{{/if}}</strong>
        </div>
        <div class="pr-results__cell pr-results__cell--red">
          <label>Rang</label>
          <strong>{{#if report.classRank}}{{report.classRank}}{{else}}—{{/if}}<span class="pr-val-denom"> / {{#if report.classSize}}{{report.classSize}}{{else}}—{{/if}}</span></strong>
        </div>
        <div class="pr-results__cell">
          <label>Conduite</label>
          <strong>{{report.conductLabel}}</strong>
        </div>
        <div class="pr-results__cell">
          <label>Abs. non justifiées</label>
          <strong>{{#if report.hasAbsent}}{{report.attendanceAbsent}} j{{else}}—{{/if}}</strong>
        </div>
        <div class="pr-results__cell">
          <label>Abs. justifiées</label>
          <strong>{{#if report.hasExcused}}{{report.attendanceExcused}} j{{else}}—{{/if}}</strong>
        </div>
        <div class="pr-results__cell">
          <label>Retards</label>
          <strong>{{lateLabel}}</strong>
        </div>
        {{#if report.honorCouncil}}
        <div class="pr-results__cell pr-results__cell--honor">
          <strong>🏆 Tableau d'honneur</strong>
        </div>
        {{/if}}
      </div>
    </div>
    <div class="pr-results__section pr-results__section--class">
      <div class="pr-results__section-title">Statistiques de la classe</div>
      <div class="pr-results__cells">
        <div class="pr-results__cell"><label>Moy. de la classe</label><strong>{{scale.classAverage}}</strong></div>
        <div class="pr-results__cell pr-results__cell--high pr-results__cell--red"><label>Plus forte moy.</label><strong>{{scale.classHighest}}</strong></div>
        <div class="pr-results__cell pr-results__cell--low pr-results__cell--red"><label>Plus faible moy.</label><strong>{{scale.classLowest}}</strong></div>
        <div class="pr-results__cell"><label>Effectif</label><strong>{{#if report.classSize}}{{report.classSize}}{{else}}—{{/if}}</strong></div>
      </div>
    </div>
  </div>

  {{#if scale.annualAverage}}
  <div class="pr-annual-bar">
    <div class="pr-annual-bar__cell">
      <label>Moyenne Annuelle</label>
      <strong class="{{#if annualFailing}}pr-val--fail{{else}}pr-val--pass{{/if}}">{{scale.annualAverage}}<span class="pr-val-denom"> / {{scale.denom}}</span></strong>
    </div>
    <div class="pr-annual-bar__decision">
      <label>Décision du Conseil</label>
      <strong class="{{#if annualFailing}}pr-val--fail{{else}}pr-val--pass{{/if}}">{{#if report.councilDecision}}{{report.councilDecision}}{{else}}—{{/if}}</strong>
    </div>
  </div>
  {{/if}}

  <!-- Appréciations -->
  <div class="pr-comments">
    <div class="pr-comment-box">
      <div class="pr-comment-box__label">Appréciations du Professeur Principal</div>
      <div class="pr-comment-box__text">{{#if report.teacherComment}}« {{report.teacherComment}} »{{else}}<span class="pr-comment-box__empty">&nbsp;</span>{{/if}}</div>
    </div>
    <div class="pr-comment-box">
      <div class="pr-comment-box__label">Appréciations de la Direction</div>
      <div class="pr-comment-box__text">{{#if report.principalComment}}« {{report.principalComment}} »{{else}}<span class="pr-comment-box__empty">&nbsp;</span>{{/if}}</div>
    </div>
  </div>

  <!-- Signatures -->
  <div class="pr-signatures">
    <div class="pr-sig">
      {{#if classTeacherSignature}}<div class="pr-sig__area pr-sig__area--signed"><img src="{{classTeacherSignature}}" alt="Signature du titulaire" /></div>{{else}}<div class="pr-sig__area"></div>{{/if}}
      <div class="pr-sig__line"></div>
      <div class="pr-sig__name">{{classTeacherName}}</div>
      <div class="pr-sig__label">Le Professeur Principal</div>
    </div>
    <div class="pr-sig pr-sig--stamp">
      <div class="pr-sig__area pr-sig__area--stamp"></div>
      <div class="pr-sig__label pr-sig__label--stamp">Cachet de l'établissement</div>
    </div>
    <div class="pr-sig">
      <div class="pr-sig__area"></div>
      <div class="pr-sig__line"></div>
      <div class="pr-sig__name">{{#if institution.name}}Direction — {{institution.name}}{{else}}Le Directeur{{/if}}</div>
      <div class="pr-sig__label">Le Directeur</div>
    </div>
    <div class="pr-sig pr-sig--visa">
      <div class="pr-sig__area"></div>
      <div class="pr-sig__line"></div>
      <div class="pr-sig__date">Vu le : ___ / ___ / ______</div>
      <div class="pr-sig__label">Visa des Parents</div>
    </div>
  </div>

  <!-- Pied de page -->
  <div class="pr-footer">
    <span>Généré le {{generatedAt}}{{#if institution.name}} — {{institution.name}}{{/if}}</span>
    <span class="pr-footer__security">
      N° Série : <strong>{{serial}}</strong> · Vérifier sur <span class="pr-footer__verify-url">{{verifyUrl}}</span>
    </span>
  </div>

  </div>
</div>

<script>
  // Une seule page A4 — même calcul que PrintReportCardPage.jsx : si le contenu dépasse la
  // feuille, on le réduit (transform: scale) juste assez pour qu'il tienne.
  window.__fitBulletin = function () {
    var el = document.querySelector('.print-page__fit');
    if (!el) return;
    el.style.setProperty('--fit', '1');
    var available = el.clientHeight;
    el.style.height = 'auto';
    var content = el.offsetHeight;
    el.style.height = '';
    var next = content > available ? Math.max(0.5, Math.floor((available / content) * 100) / 100) : 1;
    el.style.setProperty('--fit', String(next));
  };
  window.__fitBulletin();
</script>
</body>
</html>
