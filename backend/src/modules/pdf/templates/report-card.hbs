<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<style>
:root {
  --c-primary:   {{institution.primaryColor}};
  --c-secondary: {{institution.secondaryColor}};
  --c-primary-light: color-mix(in srgb, var(--c-primary) 10%, white);
  --c-primary-text:  color-mix(in srgb, var(--c-primary) 85%, black);
  --c-line: #3f3f46;
  --c-good: #15803d;
  --c-pass: #b45309;
  --c-fail: #b91c1c;
}
* { margin:0; padding:0; box-sizing:border-box; }
body {
  font-family: Arial, Helvetica, sans-serif; font-size:10.5px; color:#111; background:#fff;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.page { width:210mm; min-height:297mm; padding:10mm 12mm; position:relative; }
.sheet { border:2px solid var(--c-primary); position:relative; }

/* ── Bandeau nom de l'école ── */
.top-bar {
  background:var(--c-primary); color:#fff; text-align:center;
  font-size:22px; font-weight:900; letter-spacing:1px; text-transform:uppercase; line-height:1.2;
  padding:7px 10px; border-bottom:3px solid var(--c-secondary);
}
.country {
  display:flex; justify-content:space-between; gap:10px;
  font-size:8px; color:#4b5563; text-transform:uppercase; letter-spacing:0.5px;
  padding:3px 10px; border-bottom:1px solid #e5e7eb;
}

/* ── En-tête : logo | coordonnées + titre | photo ── */
.hd { display:flex; align-items:center; gap:12px; padding:8px 10px 6px; }
.hd-logo { width:84px; height:84px; object-fit:contain; flex-shrink:0; }
.hd-mid { flex:1; min-width:0; }
.hd-contacts { list-style:none; display:flex; flex-direction:column; gap:3px; margin-bottom:6px; }
.hd-contacts li { display:flex; align-items:center; gap:7px; font-size:11px; color:#1f2937; }
.hd-contacts .ico {
  width:16px; height:16px; flex-shrink:0; border-radius:50%;
  background:var(--c-primary); display:flex; align-items:center; justify-content:center;
}
.hd-contacts .ico svg { width:9px; height:9px; fill:#fff; }
.hd-contacts .motto { font-style:italic; font-weight:700; color:var(--c-primary-text); }
.hd-title {
  display:inline-block; background:var(--c-primary); color:#fff;
  font-size:11.5px; font-weight:800; letter-spacing:1px; text-transform:uppercase;
  padding:3px 12px; border-radius:2px; border-bottom:2px solid var(--c-secondary);
}
.hd-title .term { text-transform:none; }
.hd-photo {
  width:78px; height:94px; flex-shrink:0; overflow:hidden;
  border:2px solid var(--c-primary); background:#f3f4f6;
  display:flex; align-items:center; justify-content:center;
}
.hd-photo img { width:100%; height:100%; object-fit:cover; }
.hd-photo svg { width:48px; height:48px; fill:#cbd5e1; }

/* ── Identité de l'élève ── */
.info { width:100%; border-collapse:collapse; font-size:11px; margin:0 0 6px; }
.info td { padding:2px 10px 2px 0; vertical-align:top; }
.info td:first-child { padding-left:10px; }
.info .lbl { font-weight:700; white-space:nowrap; width:18%; }
.info .sep { width:6px; font-weight:700; padding-right:6px; }
.info .val { font-weight:700; color:var(--c-primary-text); width:32%; }
.info .val--strong { color:var(--c-good); font-size:12px; }
.info .val--fail { color:var(--c-fail); }

/* ── Tableau des notes ── */
/* Largeurs fixes : le tableau ne dépasse jamais du cadre, quel que soit le contenu */
.grades { width:100%; border-collapse:collapse; font-size:9px; table-layout:fixed; }
.grades th, .grades td {
  border:1px solid var(--c-line); padding:3px 2px; text-align:center; vertical-align:middle;
  overflow-wrap:anywhere;
}
.grades thead th {
  background:#fff; color:#111; font-weight:800; font-size:7.5px; text-transform:uppercase; line-height:1.15;
  border-top:2px solid var(--c-line); border-bottom:2px solid var(--c-line);
  overflow-wrap:normal; word-break:normal; hyphens:none;
}
.grades thead th small { display:block; font-weight:600; text-transform:none; color:#4b5563; }
.grades .c-num  { font-weight:700; }
.grades .c-mat  { text-align:left; font-weight:700; padding-left:4px; overflow-wrap:normal; }
.grades .c-mi   { font-style:italic; color:#374151; }
.grades .c-moy  { font-weight:800; font-size:10px; color:var(--c-primary-text); }
.grades .c-moy.fail { color:var(--c-fail); }
.grades .c-pts  { font-weight:700; }
.grades .c-rang { font-weight:800; color:var(--c-good); }
.grades .c-appr { text-align:left; font-weight:700; font-size:8.5px; overflow-wrap:normal; }
.grades .c-prof { text-align:left; font-size:8px; overflow-wrap:normal; }
.grades .lvl-good { color:var(--c-good); }
.grades .lvl-pass { color:var(--c-pass); }
.grades .lvl-fail { color:var(--c-fail); }
.grades tbody tr { page-break-inside:avoid; }
.grades tfoot td { font-weight:800; font-size:9.5px; border-top:2px solid var(--c-line); white-space:nowrap; overflow-wrap:normal; }
.grades tfoot .t-label { text-align:right; padding-right:8px; letter-spacing:0.5px; }
.grades tfoot .t-val { color:var(--c-fail); }

/* ── Bas de page : observations | résultats ── */
.bottom { display:flex; border-top:2px solid var(--c-line); }
.bottom-left { flex:1.45; padding:6px 10px; border-right:2px solid var(--c-line); }
.bottom-right { flex:1; display:flex; flex-direction:column; }

.kv { width:100%; border-collapse:collapse; font-size:10.5px; }
.kv td { padding:2.5px 0; vertical-align:top; }
.kv .k { font-weight:700; white-space:nowrap; width:38%; padding-right:8px; }
.kv .v { color:#111; }
.kv .v--muted { color:#9ca3af; font-style:italic; }
.kv .v--pass { color:var(--c-good); font-weight:800; text-transform:uppercase; }
.kv .v--fail { color:var(--c-fail); font-weight:800; text-transform:uppercase; }
.chip { display:inline-block; font-size:9px; font-weight:700; padding:1px 6px; border-radius:8px; margin:0 3px 2px 0; }
.chip--honor   { background:#fef9c3; border:1px solid #f59e0b; color:#92400e; }
.chip--commend { background:#dcfce7; border:1px solid #86efac; color:#166534; }
.chip--warn    { background:#fef2f2; border:1px solid #fca5a5; color:#991b1b; }

.res-title {
  background:var(--c-primary); color:#fff; text-align:center;
  font-size:10.5px; font-weight:800; letter-spacing:1px; text-transform:uppercase;
  padding:4px 6px; border-bottom:2px solid var(--c-secondary);
}
.res { width:100%; border-collapse:collapse; font-size:10.5px; flex:1; }
.res td { border-bottom:1px solid var(--c-line); padding:3px 8px; }
.res td:last-child { text-align:right; font-weight:700; border-left:1px solid var(--c-line); width:42%; }
.res tr.sub td { font-weight:800; border-top:2px solid var(--c-line); }
.res tr.grand td { font-weight:900; font-size:12px; background:var(--c-primary-light); }
.res tr.grand td:last-child { color:var(--c-good); }
.res tr.grand td.fail { color:var(--c-fail); }
.res tr:last-child td { border-bottom:none; }

/* ── QR + barème ── */
.verify { display:flex; align-items:center; gap:10px; margin-top:8px; }
.verify .qr { width:64px; height:64px; flex-shrink:0; }
.verify .qr img { width:64px; height:64px; display:block; }
.verify .code { font-size:6.5px; color:#4b5563; text-align:center; margin-top:1px; letter-spacing:0.3px; }
.scale { flex:1; border:1px solid var(--c-line); padding:4px 7px; font-size:8.5px; line-height:1.45; }
.scale-title { text-align:center; font-weight:800; font-size:8.5px; text-transform:uppercase; margin-bottom:2px; }

/* ── Signatures ── */
.signatures { display:flex; border-top:2px solid var(--c-line); }
.sig-box { flex:1; text-align:center; padding:6px 10px 8px; border-right:1px solid var(--c-line); }
.sig-box:last-child { border-right:none; }
.sig-title { font-size:9.5px; font-weight:800; text-transform:uppercase; color:var(--c-primary-text); }
.sig-hint  { font-size:8px; color:#9ca3af; margin-bottom:20px; }
.sig-line  { border-bottom:1px solid #374151; margin:0 12px 3px; }
.sig-name  { font-size:8.5px; color:#374151; }

/* ── Filigrane : nom de l'école en diagonale, au-dessus du contenu mais très léger ── */
.watermark {
  position:absolute; top:50%; left:50%; width:92%;
  transform:translate(-50%, -50%) rotate(-35deg);
  z-index:50; pointer-events:none; overflow:visible;
  /* « multiply » = comme de l'encre : teinte fortement le blanc, le texte noir reste noir et lisible */
  mix-blend-mode:multiply;
}
.watermark text {
  font-family:'Arial Black', Arial, Helvetica, sans-serif; font-weight:900;
  fill:var(--c-primary); fill-opacity:0.18;
  stroke:var(--c-primary); stroke-opacity:0.22; stroke-width:2px; paint-order:stroke;
  letter-spacing:3px;
}

/* ── Cachet + pied ── */
.stamp-area { position:absolute; bottom:28px; right:18px; opacity:0.5; }
.stamp-area img { width:84px; height:84px; object-fit:contain; }
.footer { text-align:center; font-size:8px; color:#9ca3af; padding-top:4px; }

@media print {
  @page { size:A4; margin:0; }
  body { background:#fff; }
  /* Puppeteer fournit déjà les marges : la feuille prend toute la largeur utile */
  .page { width:100%; min-height:auto; padding:0; }
  /* position fixe à l'impression = répété et centré sur chaque page */
  .watermark { position:fixed; }
}
</style>
</head>
<body>
<div class="page">
{{#if watermark}}
<svg class="watermark" aria-hidden="true" viewBox="0 0 700 {{watermark.height}}" xmlns="http://www.w3.org/2000/svg">
  {{#each watermark.lines}}
  <text x="350" y="{{this.y}}" text-anchor="middle" font-size="{{../watermark.fontSize}}"{{#if this.fit}} textLength="680" lengthAdjust="spacingAndGlyphs"{{/if}}>{{this.text}}</text>
  {{/each}}
</svg>
{{/if}}
<div class="sheet">

  <div class="top-bar">{{institution.name}}</div>
  {{#if institution.countryLine}}
  <div class="country">
    <span>{{institution.countryLine}}</span>
    {{#if institution.circonscription}}<span>{{institution.circonscription}}</span>{{/if}}
  </div>
  {{/if}}

  <!-- En-tête -->
  <div class="hd">
    {{#if institution.headerLogo}}<img class="hd-logo" src="{{institution.headerLogo}}" alt="Logo" />{{/if}}
    <div class="hd-mid">
      <ul class="hd-contacts">
        {{#if institution.phone}}<li><span class="ico"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg></span>{{institution.phone}}</li>{{/if}}
        {{#if institution.address}}<li><span class="ico"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg></span>{{institution.address}}</li>{{/if}}
        {{#if institution.email}}<li><span class="ico"><svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z"/></svg></span>{{institution.email}}</li>{{/if}}
        {{#if institution.motto}}<li><span class="ico"><svg viewBox="0 0 24 24"><path d="M12 17.3 18.2 21l-1.6-7L22 9.2l-7.2-.6L12 2 9.2 8.6 2 9.2 7.5 14l-1.7 7z"/></svg></span><span class="motto">{{institution.motto}}</span></li>{{/if}}
      </ul>
      <div class="hd-title">Bulletin de notes &mdash; <span class="term">{{report.termName}}</span></div>
    </div>
    <div class="hd-photo">
      {{#if student.photo}}<img src="{{student.photo}}" alt="Photo" />{{else}}<svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.3 0-9 2.2-9 5v3h18v-3c0-2.8-4.7-5-9-5z"/></svg>{{/if}}
    </div>
  </div>

  <!-- Identité de l'élève -->
  <table class="info">
    <tr>
      <td class="lbl">Nom et prénoms</td><td class="sep">:</td><td class="val">{{student.name}}</td>
      <td class="lbl">N° Matricule</td><td class="sep">:</td><td class="val">{{student.admissionNumber}}</td>
    </tr>
    <tr>
      <td class="lbl">Sexe</td><td class="sep">:</td><td class="val">{{student.sexLabel}}</td>
      <td class="lbl">Date de naissance</td><td class="sep">:</td><td class="val">{{student.dateOfBirth}}</td>
    </tr>
    <tr>
      <td class="lbl">Classe</td><td class="sep">:</td><td class="val">{{class.name}}</td>
      <td class="lbl">Effectif</td><td class="sep">:</td><td class="val">{{#if report.classSize}}{{report.classSize}} élèves{{else}}&mdash;{{/if}}</td>
    </tr>
    <tr>
      <td class="lbl">Rang</td><td class="sep">:</td><td class="val val--strong">{{#if report.rankLabel}}{{report.rankLabel}}{{#if report.classSize}} / {{report.classSize}}{{/if}}{{else}}&mdash;{{/if}}</td>
      <td class="lbl">Année scolaire</td><td class="sep">:</td><td class="val">{{report.academicYear}}</td>
    </tr>
    <tr>
      <td class="lbl">Moyenne générale</td><td class="sep">:</td><td class="val val--strong{{#unless report.isPassing}} val--fail{{/unless}}">{{#if report.averageLabel}}{{report.averageLabel}} / 20{{else}}&mdash;{{/if}}</td>
      <td class="lbl">Période</td><td class="sep">:</td><td class="val">{{report.termName}}</td>
    </tr>
    <tr>
      <td class="lbl">Mention</td><td class="sep">:</td><td class="val">{{#if report.mention}}{{report.mention}}{{else}}&mdash;{{/if}}</td>
      <td class="lbl">Conduite</td><td class="sep">:</td><td class="val">{{report.conductLabel}}</td>
    </tr>
  </table>

  <!-- Tableau des notes -->
  <table class="grades">
    <colgroup>
      <col style="width:3%" />   <!-- N° -->
      <col style="width:15%" />  <!-- Matières -->
      <col style="width:4%" /><col style="width:4%" /><col style="width:4%" /><col style="width:4%" />
      <col style="width:4.5%" /> <!-- Moy. int. -->
      <col style="width:5.5%" /> <!-- Devoir -->
      <col style="width:6%" />   <!-- Examen -->
      <col style="width:6%" />   <!-- Moy. -->
      <col style="width:4%" />   <!-- Coef. -->
      <col style="width:6%" />   <!-- Points -->
      <col style="width:4.5%" /> <!-- Rang -->
      <col style="width:10.5%" /><!-- Appréciation -->
      <col style="width:10%" />  <!-- Professeur -->
      <col style="width:9%" />   <!-- Signature -->
    </colgroup>
    <thead>
      <tr>
        <th class="c-num" rowspan="2">N°</th>
        <th class="c-mat" rowspan="2">Matières</th>
        <th colspan="5">Notes de classe</th>
        <th rowspan="2">Devoir<small>/20</small></th>
        <th rowspan="2">Examen<small>/20</small></th>
        <th rowspan="2">Moy.<small>/20</small></th>
        <th rowspan="2">Coef.</th>
        <th rowspan="2">Points</th>
        <th rowspan="2">Rang</th>
        <th rowspan="2">Appré&shy;ciation</th>
        <th rowspan="2">Profes&shy;seur</th>
        <th rowspan="2">Signa&shy;ture</th>
      </tr>
      <tr>
        <th class="c-note">Int.1</th>
        <th class="c-note">Int.2</th>
        <th class="c-note">Int.3</th>
        <th class="c-note">Int.4</th>
        <th class="c-note">Moy.<small>int.</small></th>
      </tr>
    </thead>
    <tbody>
      {{#each grades}}
      <tr>
        <td class="c-num">{{inc @index}}</td>
        <td class="c-mat">{{subject.nameFr}}</td>
        <td class="c-note">{{fmtNote this.noteInterro1}}</td>
        <td class="c-note">{{fmtNote this.noteInterro2}}</td>
        <td class="c-note">{{fmtNote this.noteInterro3}}</td>
        <td class="c-note">{{fmtNote this.noteInterro4}}</td>
        <td class="c-note c-mi">{{fmtNote this.moyInterros}}</td>
        <td class="c-note">{{fmtNote this.noteDevoir}}</td>
        <td class="c-note">{{fmtNote this.noteComposition}}</td>
        <td class="c-moy{{#unless this.passed}} fail{{/unless}}">{{fmtScore this.moyenneMatiere}}</td>
        <td>{{this.coefficient}}</td>
        <td class="c-pts">{{fmtScore this.weightedScore}}</td>
        <td class="c-rang">{{#if this.rangLabel}}{{this.rangLabel}}{{else}}&mdash;{{/if}}</td>
        <td class="c-appr {{this.levelClass}}">{{this.appreciation}}</td>
        <td class="c-prof">{{this.teacherName}}</td>
        <td class="c-sig">
          {{#if this.signatureData}}
            <img src="{{this.signatureData}}" alt="sig" style="max-height:28px;max-width:78px;object-fit:contain;display:block;margin:0 auto;" />
            {{#if this.ficheSignedAt}}<span style="font-size:7px;color:#0f766e;display:block;">&#10003; {{this.ficheSignedAt}}</span>{{/if}}
          {{else}}
            <div style="border-bottom:1px dotted #9ca3af;margin:8px 4px 0;"></div>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr>
        <td class="t-label" colspan="9">TOTAUX</td>
        <td class="t-val">{{fmtScore report.overallAverage}}</td>
        <td>{{report.totalCoef}}</td>
        <td class="t-val">{{fmtScore report.totalPoints}}</td>
        <td colspan="4"></td>
      </tr>
    </tfoot>
  </table>

  <!-- Observations | Résultats -->
  <div class="bottom">
    <div class="bottom-left">
      <table class="kv">
        {{#if report.hasAttendance}}
        <tr>
          <td class="k">Assiduité</td>
          <td class="v">
            Abs. non justifiées : <b>{{#if report.attendanceAbsent}}{{report.attendanceAbsent}}{{else}}0{{/if}} j</b>
            &nbsp;·&nbsp; Abs. justifiées : <b>{{#if report.attendanceExcused}}{{report.attendanceExcused}}{{else}}0{{/if}} j</b>
            &nbsp;·&nbsp; Retards : <b>{{#if report.lateHours}}{{report.lateHours}} h{{else}}{{#if report.attendanceLate}}{{report.attendanceLate}}{{else}}0 h{{/if}}{{/if}}</b>
            {{#if report.attendanceDays}}<br>Jours de cours : <b>{{report.attendanceDays}}</b>{{#if report.attendanceRate}} &nbsp;·&nbsp; Taux : <b>{{report.attendanceRate}} %</b>{{/if}}{{/if}}
          </td>
        </tr>
        {{/if}}
        <tr><td class="k">Conduite</td><td class="v">{{report.conductLabel}}</td></tr>
        {{#if report.hasDistinctions}}
        <tr>
          <td class="k">Distinctions</td>
          <td class="v">
            {{#if report.honorCouncil}}<span class="chip chip--honor">&#9733; Tableau d&apos;honneur</span>{{/if}}
            {{#if report.commendations}}<span class="chip chip--commend">Félicitations : {{report.commendations}}</span>{{/if}}
            {{#if report.warnings}}<span class="chip chip--warn">Avertissement(s) : {{report.warnings}}</span>{{/if}}
          </td>
        </tr>
        {{/if}}
        <tr>
          <td class="k">Obs. du Prof. principal</td>
          <td class="v{{#unless report.teacherComment}} v--muted{{/unless}}">{{#if report.teacherComment}}{{report.teacherComment}}{{else}}Aucune observation{{/if}}</td>
        </tr>
        <tr>
          <td class="k">Obs. du Conseil des prof.</td>
          <td class="v{{#unless report.principalComment}} v--muted{{/unless}}">{{#if report.principalComment}}{{report.principalComment}}{{else}}Aucune observation{{/if}}</td>
        </tr>
        {{#if report.councilDecision}}
        <tr>
          <td class="k">Décision du Conseil</td>
          <td class="v {{#if report.annualIsPassing}}v--pass{{else}}v--fail{{/if}}">{{report.councilDecision}}</td>
        </tr>
        {{/if}}
      </table>

      <div class="verify">
        {{#if qrDataUri}}
        <div>
          <div class="qr"><img src="{{qrDataUri}}" alt="Code de vérification" /></div>
          {{#if report.securityCode}}<div class="code">{{report.securityCode}}</div>{{/if}}
        </div>
        {{/if}}
        <div class="scale">
          <div class="scale-title">Barème des mentions</div>
          18 à 20 : Excellent &nbsp;·&nbsp; 16 à 17,99 : Très Bien &nbsp;·&nbsp; 14 à 15,99 : Bien &nbsp;·&nbsp;
          12 à 13,99 : Assez Bien &nbsp;·&nbsp; 10 à 11,99 : Passable &nbsp;·&nbsp; 0 à 9,99 : Insuffisant
        </div>
      </div>
    </div>

    <div class="bottom-right">
      <div class="res-title">Résultats</div>
      <table class="res">
        <tr><td>Moy. la plus forte</td><td>{{fmtScore report.classHighest}}</td></tr>
        <tr><td>Moy. la plus faible</td><td>{{fmtScore report.classLowest}}</td></tr>
        <tr><td>Moy. de la classe</td><td>{{fmtScore report.classAverage}}</td></tr>
        <tr><td>Mention</td><td>{{#if report.mention}}{{report.mention}}{{else}}&mdash;{{/if}}</td></tr>
        <tr class="sub"><td>Rang</td><td>{{#if report.rankLabel}}{{report.rankLabel}}{{#if report.classSize}} / {{report.classSize}}{{/if}}{{else}}&mdash;{{/if}}</td></tr>
        <tr class="grand"><td>Moyenne générale</td><td class="{{#unless report.isPassing}}fail{{/unless}}">{{fmtScore report.overallAverage}} / 20</td></tr>
        {{#if report.annualAverage}}
        <tr class="grand"><td>Moyenne annuelle</td><td class="{{#unless report.annualIsPassing}}fail{{/unless}}">{{fmtScore report.annualAverage}} / 20</td></tr>
        {{/if}}
      </table>
    </div>
  </div>

  <!-- Signatures -->
  <div class="signatures">
    <div class="sig-box">
      <div class="sig-title">Le Professeur Principal</div>
