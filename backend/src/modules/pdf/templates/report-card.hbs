<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<style>
:root {
  --c-primary:   {{institution.primaryColor}};
  --c-secondary: {{institution.secondaryColor}};
  --c-primary-light: color-mix(in srgb, var(--c-primary) 10%, white);
  --c-primary-text:  color-mix(in srgb, var(--c-primary) 85%, black);
}
* { margin:0; padding:0; box-sizing:border-box; }
body {
  font-family: Arial, Helvetica, sans-serif; font-size:11px; color:#111; background:#fff;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.page { width:210mm; min-height:297mm; padding:10mm 12mm 20mm; position:relative; }

/* ── Header ── */
.header {
  display:flex; align-items:center;
  border-bottom:3px solid var(--c-primary);
  padding-bottom:10px; margin-bottom:10px;
}
.header .logo  { width:85px; height:85px; object-fit:contain; margin-right:14px; flex-shrink:0; }
.header .crest { width:85px; height:85px; object-fit:contain; margin-left:14px;  flex-shrink:0; }
.header .center { flex:1; text-align:center; }
.header .center .country { font-size:8.5px; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:3px; }
.header .center h1 {
  font-size:17px; font-weight:bold;
  color:var(--c-primary); text-transform:uppercase; letter-spacing:1.5px;
  line-height:1.2;
}
.header .center .subtitle { font-size:11px; color:#444; margin-top:3px; }
.header .center .motto    { font-size:11px; font-style:italic; color:#374151; margin-top:3px; }

/* ── Title bar ── */
.title-bar {
  background:var(--c-primary); color:#fff;
  text-align:center; padding:7px 10px;
  font-size:14px; font-weight:bold; letter-spacing:1.5px;
  margin-bottom:10px;
}

/* ── Student band ── */
.student-band {
  display:flex; border:2px solid var(--c-primary);
  border-radius:4px; margin-bottom:10px; overflow:hidden;
}
.student-band .photo-cell {
  display:flex; align-items:center; justify-content:center; padding:6px 8px;
  border-right:1px solid #9ca3af; flex-shrink:0;
}
.student-band .photo-cell img {
  width:64px; height:80px; object-fit:cover;
  border-radius:2px; border:2px solid var(--c-primary);
}
.student-band .fields { display:flex; flex:1; flex-wrap:wrap; }
.student-band .field {
  flex:1; min-width:110px;
  padding:6px 10px; border-right:1px solid #c7d0da;
}
.student-band .field:last-child { border-right:none; }
.student-band .field label {
  display:block; font-size:8.5px; font-weight:bold;
  color:var(--c-primary); text-transform:uppercase; margin-bottom:3px;
  letter-spacing:0.4px;
}
.student-band .field span { font-size:12px; font-weight:700; color:#111; }

/* ── Grades table ── */
.grades-table { width:100%; border-collapse:collapse; margin-bottom:10px; font-size:10px; }
.grades-table th, .grades-table td {
  border:1px solid #c4c9d4; padding:4px 4px;
  text-align:center; vertical-align:middle;
}
.grades-table thead tr:first-child th {
  background:var(--c-primary); color:#fff;
  font-size:10px; font-weight:bold; padding:5px 4px;
}
.grades-table thead tr:last-child th {
  background:var(--c-primary-light); color:var(--c-primary-text);
  font-size:9.5px; font-weight:700;
}
.grades-table .col-matiere {
  text-align:left; min-width:100px; font-weight:700; font-size:10.5px;
  padding-left:7px; background:#f8f9fb;
}
.grades-table .col-num    { min-width:30px; }
.grades-table .col-moy    { background:#dcfce7; font-weight:700; min-width:34px; font-size:11px; }
.grades-table .col-moy-i  { background:#dbeafe; font-style:italic; }
.grades-table .col-dev    { background:rgba(254,252,193,0.55); }
.grades-table .col-cmp    { background:rgba(250,232,255,0.55); }
.grades-table .col-coef   { min-width:30px; }
.grades-table .col-pts    { background:#f0fdf4; font-weight:700; }
.grades-table .col-rang   { color:#0f766e; font-weight:700; min-width:30px; font-size:11px; }
.grades-table .col-appr   { text-align:left; min-width:70px; font-size:10px; }
.grades-table .col-prof   { text-align:left; min-width:75px; font-size:9.5px; }
.grades-table .col-sig-hbs { min-width:60px; }
.grades-table tbody tr { page-break-inside: avoid; }
.grades-table tbody tr:nth-child(even) { background:#f8fafb; }
.grades-table tbody td.fail { color:#dc2626; font-weight:bold; }
.grades-table tbody td.pass { color:#15803d; font-weight:600; }
.grades-table tfoot { page-break-before: avoid; }
.grades-table tfoot td {
  background:var(--c-primary); color:#fff;
  font-weight:bold; font-size:11px; padding:5px 4px;
}

/* ── Summary strip ── */
.summary {
  display:flex; border:2px solid var(--c-primary);
  border-radius:4px; margin-bottom:10px; overflow:hidden;
}
.sum-card {
  flex:1; padding:10px 8px; text-align:center;
  border-right:1px solid #c7d0da;
}
.sum-card:last-child { border-right:none; }
.sum-card .label { font-size:9px; color:#555; text-transform:uppercase; font-weight:700; margin-bottom:5px; letter-spacing:0.3px; }
.sum-card .value { font-size:26px; font-weight:bold; color:var(--c-primary); line-height:1.1; }
.sum-card .value.fail    { color:#dc2626; }
.sum-card .value.pass    { color:#15803d; }
.sum-card .value--lg     { font-size:20px; }
.sum-card .mention       { font-size:16px; font-weight:bold; }
.sum-card .mention.fail  { color:#dc2626; }
.sum-card .mention.pass  { color:#15803d; }

/* ── Annual average + council decision ── */
.annual-bar {
  display:flex; align-items:stretch; border:2px solid var(--c-primary);
  border-radius:4px; margin-bottom:10px; overflow:hidden;
}
.annual-bar .ann-cell {
  flex:1; padding:8px 12px; text-align:center; border-right:1px solid #c7d0da;
}
.annual-bar .ann-cell:last-child { border-right:none; }
.annual-bar .ann-label {
  font-size:8.5px; color:#555; text-transform:uppercase;
  font-weight:700; margin-bottom:4px; letter-spacing:0.3px;
}
.annual-bar .ann-value { font-size:24px; font-weight:bold; }
.annual-bar .ann-value.pass { color:#15803d; }
.annual-bar .ann-value.fail { color:#dc2626; }
.annual-bar .decision-cell {
  flex:2; padding:8px 14px; display:flex;
  align-items:center; justify-content:center;
}
.annual-bar .decision-text {
  font-size:14px; font-weight:800; text-transform:uppercase;
  letter-spacing:1px;
}
.annual-bar .decision-text.pass { color:#15803d; }
.annual-bar .decision-text.fail { color:#dc2626; }

/* ── Two-col section ── */
.two-col { display:flex; gap:8px; margin-bottom:10px; }
.two-col > * { flex:1; }

/* ── Attendance box ── */
.box {
  border:1px solid #d1d5db; border-radius:4px; overflow:hidden;
}
.box .box-title {
  background:var(--c-primary-light); padding:5px 10px;
  font-size:10px; font-weight:bold; color:var(--c-primary);
  text-transform:uppercase; letter-spacing:0.5px;
  border-bottom:1px solid #d1d5db;
}
.att-row { display:flex; }
.att-cell { flex:1; padding:6px 4px; text-align:center; border-right:1px solid #e5e7eb; }
.att-cell:last-child { border-right:none; }
.att-cell .att-label { font-size:8.5px; color:#6b7280; font-weight:600; }
.att-cell .att-val   { font-size:15px; font-weight:bold; color:var(--c-primary); margin-top:2px; }

/* ── Comment box ── */
.box .content { padding:7px 10px; font-size:11px; min-height:48px; color:#222; line-height:1.5; }
.box .content--empty { color:#9ca3af; font-style:italic; }
.box .honor-badge {
  display:inline-block; background:#fef9c3;
  border:1px solid #fbbf24; color:#92400e;
  font-size:10px; font-weight:bold;
  padding:2px 8px; border-radius:10px; margin-top:4px;
}

/* ── Class stats ── */
.class-stats-bar {
  display:flex; border:1px solid #d1d5db; border-radius:4px;
  margin-bottom:10px; overflow:hidden;
}
.stats-cell { flex:1; padding:6px 6px; text-align:center; border-right:1px solid #e5e7eb; }
.stats-cell:last-child { border-right:none; }
.stats-cell .stats-label { font-size:8.5px; color:#6b7280; font-weight:600; }
.stats-cell .stats-val   { font-size:15px; font-weight:bold; color:var(--c-primary); margin-top:2px; }

/* ── Honour / remarks ── */
.remark {
  padding:5px 10px; border-radius:4px; font-size:10.5px; font-weight:700;
  margin-bottom:5px;
}
.remark--honor   { background:#fef9c3; border:1px solid #fbbf24; color:#92400e; text-align:center; }
.remark--commend { background:#dcfce7; border:1px solid #86efac; color:#166534; }
.remark--warn    { background:#fef2f2; border:1px solid #fca5a5; color:#991b1b; }

/* ── Signatures ── */
.signatures {
  display:flex; border-top:2px solid var(--c-primary);
  padding-top:10px; margin-top:14px;
}
.sig-box { flex:1; text-align:center; border-right:1px solid #d1d5db; padding:0 10px; }
.sig-box:last-child { border-right:none; }
.sig-box .sig-title { font-size:10px; font-weight:bold; text-transform:uppercase; color:var(--c-primary); margin-bottom:4px; }
.sig-box .sig-line  { border-bottom:1px solid #374151; margin:0 10px 4px; }
.sig-box .sig-name  { font-size:9px; color:#6b7280; }

/* ── Stamp ── */
.stamp-area { position:absolute; bottom:22mm; right:12mm; opacity:0.5; }
.stamp-area img { width:80px; height:80px; object-fit:contain; }

/* ── Footer ── */
.footer {
  border-top:1px solid #d1d5db; padding-top:5px;
  text-align:center; font-size:9px; color:#9ca3af; margin-top:10px;
}

@media print {
  @page { size:A4; margin:0; }
  body { background:#fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .page { width:100%; min-height:auto; padding:14mm 14mm 18mm; }
  .stamp-area { position:fixed; bottom:10mm; right:10mm; }
}
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    {{#if institution.logo}}<img class="logo" src="{{institution.logo}}" alt="Logo" />{{/if}}
    <div class="center">
      {{#if institution.countryLine}}<div class="country">{{institution.countryLine}}</div>{{/if}}
      <h1>{{institution.name}}</h1>
      {{#if institution.address}}<div class="subtitle">{{institution.address}}{{#if institution.phone}} &nbsp;|&nbsp; Tél : {{institution.phone}}{{/if}}</div>{{/if}}
      {{#if institution.motto}}<div class="motto">« {{institution.motto}} »</div>{{/if}}
    </div>
    {{#if institution.crest}}<img class="crest" src="{{institution.crest}}" alt="Blason" />{{/if}}
  </div>

  <!-- Title -->
  <div class="title-bar">BULLETIN DE NOTES &mdash; {{report.termName}} &mdash; Année Scolaire {{report.academicYear}}</div>

  <!-- Student band -->
  <div class="student-band">
    {{#if student.photo}}
    <div class="photo-cell">
      <img src="{{student.photo}}" alt="Photo" />
    </div>
    {{/if}}
    <div class="fields">
      <div class="field"><label>Nom &amp; Prénom</label><span>{{student.name}}</span></div>
      <div class="field"><label>N° Matricule</label><span>{{student.admissionNumber}}</span></div>
      <div class="field"><label>Date de naissance</label><span>{{student.dateOfBirth}}</span></div>
      <div class="field"><label>Classe</label><span>{{class.name}}</span></div>
      <div class="field"><label>Année scolaire</label><span>{{report.academicYear}}</span></div>
    </div>
  </div>

  <!-- Grades table -->
  <table class="grades-table">
    <thead>
      <tr>
        <th class="col-matiere" rowspan="2">Matières</th>
        <th colspan="5">Notes de classe</th>
        <th class="col-dev"  rowspan="2">Devoir<br>/20</th>
        <th class="col-cmp"  rowspan="2">Examen<br>/20</th>
        <th class="col-moy"  rowspan="2">Moy.<br>Trim.</th>
        <th class="col-coef" rowspan="2">Coef.</th>
        <th class="col-pts"  rowspan="2">Points</th>
        <th class="col-rang" rowspan="2">Rang</th>
        <th class="col-appr" rowspan="2">Appréciation</th>
        <th class="col-prof" rowspan="2">Professeur</th>
        <th class="col-sig-hbs" rowspan="2">Signature</th>
      </tr>
      <tr>
        <th class="col-num">Int. 1</th>
        <th class="col-num">Int. 2</th>
        <th class="col-num">Int. 3</th>
        <th class="col-num">Int. 4</th>
        <th class="col-moy-i">Moy.<br>interros</th>
      </tr>
    </thead>
    <tbody>
      {{#each grades}}
      <tr>
        <td class="col-matiere">{{subject.nameFr}}</td>
        <td class="col-num">{{fmtNote this.noteInterro1}}</td>
        <td class="col-num">{{fmtNote this.noteInterro2}}</td>
        <td class="col-num">{{fmtNote this.noteInterro3}}</td>
        <td class="col-num">{{fmtNote this.noteInterro4}}</td>
        <td class="col-moy-i">{{fmtNote this.moyInterros}}</td>
        <td class="col-dev">{{fmtNote this.noteDevoir}}</td>
        <td class="col-cmp">{{fmtNote this.noteComposition}}</td>
        <td class="col-moy {{#if this.passed}}pass{{else}}fail{{/if}}">{{fmtScore this.moyenneMatiere}}</td>
        <td class="col-coef">{{this.coefficient}}</td>
        <td class="col-pts">{{fmtScore this.weightedScore}}</td>
        <td class="col-rang">{{this.rangMatiere}}{{#if this.rangMatiere}}e{{/if}}</td>
        <td class="col-appr">{{this.appreciation}}</td>
        <td class="col-prof">{{this.teacherName}}</td>
        <td class="col-sig-hbs" style="text-align:center;">
          {{#if this.signatureData}}
            <img src="{{this.signatureData}}" alt="sig" style="max-height:34px;max-width:85px;object-fit:contain;display:block;margin:3px auto 0;" />
            {{#if this.ficheSignedAt}}<span style="font-size:7.5px;color:#0f766e;display:block;">✔ {{this.ficheSignedAt}}</span>{{/if}}
          {{else}}
            <div style="border-bottom:1px dotted #9ca3af;margin:8px 4px 0;"></div>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr>
        <td class="col-matiere" colspan="8" style="text-align:right;padding-right:10px;font-size:12px;">TOTAUX</td>
        <td class="col-moy">{{fmtScore report.overallAverage}}</td>
        <td class="col-coef">{{report.totalCoef}}</td>
        <td class="col-pts">{{fmtScore report.totalPoints}}</td>
        <td colspan="4"></td>
      </tr>
    </tfoot>
  </table>

  <!-- Summary strip -->
  <div class="summary">
    <div class="sum-card">
      <div class="label">Moyenne générale</div>
      <div class="value {{#if report.isPassing}}pass{{else}}fail{{/if}}">{{fmtScore report.overallAverage}}<small style="font-size:11px;">/20</small></div>
    </div>
    <div class="sum-card">
      <div class="label">Mention</div>
      <div class="mention {{#if report.isPassing}}pass{{else}}fail{{/if}}">{{report.mention}}</div>
    </div>
    <div class="sum-card">
      <div class="label">Rang dans la classe</div>
      <div class="value">{{report.classRank}}<small style="font-size:11px;">/{{report.classSize}}</small></div>
    </div>
    <div class="sum-card">
      <div class="label">Moy. la plus forte</div>
      <div class="value value--lg">{{fmtScore report.classHighest}}</div>
    </div>
    <div class="sum-card">
      <div class="label">Moy. la plus faible</div>
      <div class="value value--lg">{{fmtScore report.classLowest}}</div>
    </div>
    <div class="sum-card">
      <div class="label">Moy. de la classe</div>
      <div class="value value--lg">{{fmtScore report.classAverage}}</div>
    </div>
    <div class="sum-card">
      <div class="label">Conduite</div>
      <div class="mention">{{report.conductLabel}}</div>
    </div>
  </div>

  {{#if report.annualAverage}}
  <!-- Annual average + council decision -->
  <div class="annual-bar">
    <div class="ann-cell">
      <div class="ann-label">Moyenne Annuelle</div>
      <div class="ann-value {{#if report.annualIsPassing}}pass{{else}}fail{{/if}}">{{fmtScore report.annualAverage}}<small style="font-size:11px;">/20</small></div>
    </div>
    <div class="decision-cell">
      <div style="text-align:center;">
        <div class="ann-label" style="margin-bottom:4px;">Décision du Conseil de Classe</div>
        <div class="decision-text {{#if report.annualIsPassing}}pass{{else}}fail{{/if}}">{{report.councilDecision}}</div>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- Attendance + remarks -->
  <div class="two-col" style="{{#unless report.attendanceDays}}display:block;{{/unless}}">
    {{#if report.attendanceDays}}
    <div class="box">
      <div class="box-title">Assiduité</div>
      <div class="att-row">
        <div class="att-cell"><div class="att-label">Jours de cours</div><div class="att-val">{{report.attendanceDays}}</div></div>
        <div class="att-cell"><div class="att-label">Présences</div><div class="att-val">{{report.attendancePresent}}</div></div>
        <div class="att-cell"><div class="att-label">H. d'absence</div><div class="att-val">{{#if report.attendanceAbsentHours}}{{report.attendanceAbsentHours}} h{{else}}—{{/if}}</div></div>
        <div class="att-cell"><div class="att-label">Retards</div><div class="att-val">{{#if report.attendanceLate}}{{report.attendanceLate}}{{else}}—{{/if}}</div></div>
        <div class="att-cell"><div class="att-label">Taux</div><div class="att-val">{{report.attendanceRate}}%</div></div>
      </div>
    </div>
    {{/if}}
    <div style="display:flex;flex-direction:column;gap:6px;justify-content:center;">
      {{#if report.honorCouncil}}
      <div class="remark remark--honor">&#11088; TABLEAU D&apos;HONNEUR &mdash; Félicitations du Conseil des Professeurs</div>
      {{/if}}
      {{#if report.commendations}}
      <div class="remark remark--commend">Félicitations : {{report.commendations}}</div>
      {{/if}}
      {{#if report.warnings}}
      <div class="remark remark--warn">Avertissement(s) : {{report.warnings}}</div>
      {{/if}}
    </div>
  </div>

  <!-- Comments -->
  <div class="two-col">
    <div class="box">
      <div class="box-title">Observation du Professeur Principal</div>
      {{#if report.teacherComment}}
      <div class="content">{{report.teacherComment}}</div>
      {{else}}
      <div class="content content--empty">Aucune observation</div>
      {{/if}}
    </div>
    <div class="box">
      <div class="box-title">Observation Générale du Conseil des Professeurs</div>
      {{#if report.principalComment}}
      <div class="content">{{report.principalComment}}</div>
      {{else}}
      <div class="content content--empty">Aucune observation</div>
      {{/if}}
    </div>
  </div>

  <!-- Signatures -->
  <div class="signatures">
    <div class="sig-box">
      <div class="sig-title">Le Professeur Principal</div>
      <div style="font-size:8.5px;color:#9ca3af;margin-bottom:22px;">(Nom et signature)</div>
      <div class="sig-line"></div>
      <div class="sig-name">&nbsp;</div>
    </div>
    <div class="sig-box">
      <div class="sig-title">Le Directeur de l&apos;École</div>
      <div style="font-size:8.5px;color:#9ca3af;margin-bottom:22px;">(Cachet et signature)</div>
      <div class="sig-line"></div>
      <div class="sig-name" style="font-size:8.5px;color:#374151;">Fait le &nbsp;_____ / _____ / _____</div>
    </div>
    <div class="sig-box" style="border:1px solid #d1d5db;border-radius:4px;padding:6px 8px;background:#fafafa;">
      <div class="sig-title">Visa des Parents</div>
      <div style="font-size:8.5px;color:#9ca3af;margin-bottom:18px;">(Lu et approuvé)</div>
      <div class="sig-line"></div>
      <div class="sig-name" style="font-size:8.5px;color:#374151;">Vu le : ___ / ___ / _______</div>
    </div>
  </div>

  {{#if institution.stamp}}
  <div class="stamp-area"><img src="{{institution.stamp}}" alt="Cachet" /></div>
  {{/if}}

  <div class="footer">
    Généré le {{generatedAt}} &nbsp;|&nbsp; {{institution.name}} &nbsp;|&nbsp; Powered by NovaBulletin
  </div>

</div>
</body>
</html>
