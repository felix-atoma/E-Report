// NovaBulletin Prisma schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled URL — used at runtime
  directUrl = env("DIRECT_URL") // direct URL — used by prisma migrate
}

enum Role {
  ADMIN
  TEACHER
  PARENT
  STUDENT
  BURSAR
  SUPERADMIN
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum Sex {
  M
  F
}

enum ReportStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  EXEMPT
}

enum PaymentMethod {
  MOBILE_MONEY_TMONEY
  MOBILE_MONEY_FLOOZ
  MOBILE_MONEY_MOMO
  MOBILE_MONEY_ONLINE
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  HELD_UNPAID
  HELD_PARTIAL
}

enum FeeType {
  TUITION
  REGISTRATION
  EXAM
  CANTEEN
  TRANSPORT
  OTHER
}

enum TermSystem {
  TRIMESTRE
  SEMESTRE
  CUSTOM
}

enum Language {
  FR
  EN
}

enum SubscriptionTier {
  STARTER
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum SubPaymentMethod {
  MOMO_MANUAL
  NOTCHPAY
}

enum SubPaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum DayOfWeek {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
}

enum ConductRating {
  TRES_BIEN
  BIEN
  PASSABLE
  MEDIOCRE
}

enum AnnouncementAudience {
  ALL
  CLASS
  TEACHERS
  STUDENTS
  PARENTS
}

enum MaterialType {
  DOCUMENT
  VIDEO
  LINK
  IMAGE
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

enum QuizStatus {
  DRAFT
  OPEN
  CLOSED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

model Institution {
  id                   String            @id @default(uuid())
  name                 String
  country              String?
  countryMotto         String?
  address              String?
  phone                String?
  email                String?
  website              String?
  motto                String?
  missionStatement     String?
  logo                 String?
  crest                String?
  stamp                String?
  brandingSettings     Json?
  academicSettings     Json?
  notchpayPublicKey    String?
  notchpayHashKeyEnc   String?
  isActive             Boolean           @default(true)
  status               InstitutionStatus @default(PENDING)
  declaredStudentCount Int?
  subscriptionPlan     String?
  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  subscriptionExpiry   DateTime?
  trialEndsAt          DateTime?
  ownerNotes           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users                User[]
  subscriptionPayments SubscriptionPayment[]
  classes             Class[]
  students            Student[]
  subjects            Subject[]
  bulletins           Bulletin[]
  fees                Fee[]
  payments            Payment[]
  paymentIntents      PaymentIntent[]
  brandingAssets      BrandingAsset[]
  reportCardTemplates ReportCardTemplate[]
  timetableSlots      TimetableSlot[]
  announcements       Announcement[]
  materials           CourseMaterial[]
  assignments         Assignment[]
  quizzes             Quiz[]
  mockExams           MockExam[]
  attendances         Attendance[]
  schoolDocuments     SchoolDocument[]
  staffProfiles       StaffProfile[]
  calendarEvents      CalendarEvent[]
  alumniRecords       AlumniRecord[]
  studentTransfers    StudentTransfer[]
  inventoryItems      InventoryItem[]
  nationalExamResults NationalExamResult[]
  libraryLoans        LibraryLoan[]
  healthRecords       HealthRecord[]
  paymentPlans        PaymentPlan[]
  incidentReports     IncidentReport[]
  purchases           Purchase[]
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  password                String
  name                    String
  role                    Role
  profileImage            String?
  whatsappNumber          String?
  whatsappVerified        Boolean   @default(false)
  language                Language  @default(FR)
  notificationPreferences Json?
  isActive                Boolean   @default(true)
  mustChangePassword      Boolean   @default(false)
  otpHash                 String?
  otpExpiresAt            DateTime?
  emailVerifiedAt         DateTime?

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  studentProfile        Student?               @relation("StudentUser")
  childrenAsParent      Student[]              @relation("ParentUser")
  classesTeaching       Class[]                @relation("ClassTeacher")
  classSubjectsTeaching ClassSubject[]
  timetableSlots        TimetableSlot[]
  reportsCreated        ReportCard[]           @relation("ReportCreator")
  bulletinsAuthored     Bulletin[]
  signedFiches          GradeFiche[]           @relation("FicheSigner")
  paymentsRecorded      Payment[]
  notificationLogs      NotificationLog[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  whatsappVerifications WhatsappVerification[]
  auditLogs             AuditLog[]
  announcementsAuthored Announcement[]         @relation("AnnouncementAuthor")
  materialsUploaded     CourseMaterial[]       @relation("MaterialUploader")
  assignmentsCreated    Assignment[]           @relation("AssignmentCreator")
  submissionsGraded     AssignmentSubmission[] @relation("SubmissionGrader")
  quizzesCreated        Quiz[]                 @relation("QuizCreator")
  mockExamsCreated      MockExam[]             @relation("MockExamCreator")
  mockExamFichesSigned  MockExamSubjectFiche[] @relation("MockExamFicheSigner")
  staffProfile          StaffProfile?
  paymentPlansCreated   PaymentPlan[]          @relation("PaymentPlanCreator")
  incidentsFiled        IncidentReport[]       @relation("IncidentReporter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id           String  @id @default(uuid())
  name         String
  level        String
  series       String?
  section      String?
  capacity     Int?
  academicYear String
  room         String?
  notes        String?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  teacherId String?
  teacher   User?   @relation("ClassTeacher", fields: [teacherId], references: [id])

  students       ClassStudent[]
  subjects       ClassSubject[]
  reportCards    ReportCard[]
  gradeFiches    GradeFiche[]
  programs       SubjectProgram[]
  timetableSlots TimetableSlot[]
  hoursLogs      SubjectHoursLog[]
  materials      CourseMaterial[]
  assignments    Assignment[]
  quizzes        Quiz[]
  mockExams      MockExam[]
  attendances    Attendance[]

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id          String  @id @default(uuid())
  nameFr      String
  nameEn      String
  code        String
  description String?
  category    String?
  department  String?
  passMark       Float   @default(10)
  maxScore       Float   @default(20)   // scale: 10 or 20
  hasCoefficient Boolean @default(true) // false = primary school (no weighting)

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  classSubjects         ClassSubject[]
  grades                Grade[]
  gradeFiches           GradeFiche[]
  programs              SubjectProgram[]
  timetableSlots        TimetableSlot[]
  hoursLogs             SubjectHoursLog[]
  materials             CourseMaterial[]
  assignments           Assignment[]
  quizzes               Quiz[]
  mockExamGrades        MockExamGrade[]
  mockExamSubjectFiches MockExamSubjectFiche[]
  attendances           Attendance[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, code])
}

model ClassStudent {
  id           String  @id @default(uuid())
  classId      String
  studentId    String
  academicYear String
  term         String?

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId, academicYear])
}

model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  teacherId String?

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User?   @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
}

model Student {
  id              String   @id @default(uuid())
  admissionNumber String   @unique
  dateOfBirth     DateTime
  enrollmentDate  DateTime @default(now())
  sex             Sex?

  userId String? @unique
  user   User?   @relation("StudentUser", fields: [userId], references: [id])

  parentId String?
  parent   User?   @relation("ParentUser", fields: [parentId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  address                  String?
  city                     String?
  region                   String?
  nationality              String?
  religion                 String?
  bloodType                String?
  medicalConditions        String?
  allergies                String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  fatherName               String?
  fatherPhone              String?
  fatherOccupation         String?
  motherName               String?
  motherPhone              String?
  motherOccupation         String?
  previousSchool           String?
  birthPlace               String?
  birthCertificateNumber   String?
  photo                    String?
  studentStatus            StudentStatus        @default(ACTIVE)
  disciplinaryRecords      DisciplinaryRecord[]

  classes               ClassStudent[]
  reportCards           ReportCard[]
  studentFees           StudentFee[]
  payments              Payment[]
  paymentIntents        PaymentIntent[]
  paymentPlans          PaymentPlan[]
  notificationLogs      NotificationLog[]
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts          QuizAttempt[]
  mockExamGrades        MockExamGrade[]
  attendances           Attendance[]
  alumniRecord          AlumniRecord?
  transfers             StudentTransfer[]
  nationalExamResults   NationalExamResult[]
  libraryLoans          LibraryLoan[]
  healthRecords         HealthRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportCard {
  id                    String         @id @default(uuid())
  studentId             String
  classId               String
  academicYear          String
  termType              TermSystem
  termNumber            Int
  termName              String
  status                ReportStatus   @default(DRAFT)
  teacherComment        String? // Nom et observation du prof titulaire
  principalComment      String? // Observations générales du conseil des profs
  conductRating         ConductRating?
  attendanceDays        Int? // Nombre de jours de classe
  attendancePresent     Int? // Jours de présence
  attendanceLate        Int? // Retards
  attendanceAbsent      Int? // Absences (in half-days)
  attendanceAbsentHours Int? // Heures d'absence
  attendanceExcluded    Int? // Exclusions
  warnings              Int? // Avertissements
  commendations         Int? // Félicitations
  honorCouncil          Boolean? // Tableau d'honneur
  overallAverage        Float? // Moyenne générale du trimestre
  classRank             Int? // Rang dans la classe
  classSize             Int? // Effectif de la classe
  classHighest          Float? // Moyenne la plus forte de la classe
  classLowest           Float? // Moyenne la plus faible
  classAverage          Float? // Moyenne de la classe
  mention               String? // Mention (TB, B, AB, P, Insuf.)
  annualAverage         Float? // Moyenne annuelle (dernier trimestre/semestre seulement)
  councilDecision       String? // Décision du conseil (ex: Admis, Redoublant)
  securityCode          String?        @unique // Anti-fraud bulletin ID e.g. "2425T1-AB3K-MNPQ"
  pdfUrl                String?
  deliveryStatus        String?
  publishedAt           DateTime?

  createdById String?
  createdBy   User?   @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  student          Student           @relation(fields: [studentId], references: [id])
  class            Class             @relation(fields: [classId], references: [id])
  grades           Grade[]
  notificationLogs NotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYear, termNumber])
}

model Grade {
  id           String @id @default(uuid())
  reportCardId String
  subjectId    String

  // Togolese bulletin note breakdown
  noteInterro1    Float? // 1ère interrogation /20
  noteInterro2    Float? // 2ème interrogation /20
  noteInterro3    Float? // 3ème interrogation /20
  noteInterro4    Float? // 4ème interrogation /20
  noteDevoir      Float? // Devoir surveillé /20
  noteComposition Float? // Composition (examen) /20

  // Computed values (stored for fast display)
  moyenneMatiere Float? // Moyenne trimestrielle dans la matière /20
  coefficient    Float   @default(1)
  weightedScore  Float? // moyenneMatiere × coefficient
  rangMatiere    Int? // Rang dans la matière au sein de la classe
  appreciation   String? // TB / B / AB / P / F

  // Backward-compat / legacy field (mirrors moyenneMatiere)
  score          Float   @default(0)
  teacherComment String? // Observation libre du prof de la matière
  teacherName    String? // Nom du professeur de la matière (pour signature)

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportCardId, subjectId])
}

model SubjectProgram {
  id           String  @id @default(uuid())
  classId      String
  subjectId    String
  academicYear String
  description  String? @db.Text

  class    Class            @relation(fields: [classId], references: [id])
  subject  Subject          @relation(fields: [subjectId], references: [id])
  chapters ProgramChapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId, academicYear])
}

model ProgramChapter {
  id          String  @id @default(uuid())
  programId   String
  order       Int
  title       String
  plan        String? @db.Text
  objectives  String? @db.Text
  duration    String? // e.g. "3 semaines"
  isCompleted Boolean @default(false)

  program SubjectProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, order])
}

model Bulletin {
  id             String    @id @default(uuid())
  title          String
  content        String    @db.Text
  type           String
  targetAudience String
  targetId       String?
  attachments    Json?
  publishedAt    DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tracks teacher sign-off on a fiche de notes (class × subject × term)
model GradeFiche {
  id           String @id @default(uuid())
  classId      String
  subjectId    String
  academicYear String
  termNumber   Int
  termName     String

  signedAt      DateTime?
  signedByName  String?
  signedById    String?
  signatureData String?   @db.Text
  signedBy      User?     @relation("FicheSigner", fields: [signedById], references: [id])

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId, academicYear, termNumber])
}

model BrandingAsset {
  id       String  @id @default(uuid())
  type     String
  label    String?
  fileUrl  String
  metadata Json?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportCardTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?
  templateKey String
  config      Json
  isDefault   Boolean @default(false)

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fee {
  id               String  @id @default(uuid())
  name             String
  feeType          FeeType
  amount           Decimal @db.Decimal(12, 2)
  currency         String  @default("XOF")
  academicYear     String
  term             String?
  appliesToLevel   String?
  appliesToClassId String?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  studentFees StudentFee[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentFee {
  id              String  @id @default(uuid())
  studentId       String
  feeId           String
  academicYear    String
  term            String?
  amountDue       Decimal @db.Decimal(12, 2)
  isExempt        Boolean @default(false)
  exemptionReason String?

  student Student @relation(fields: [studentId], references: [id])
  fee     Fee     @relation(fields: [feeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, feeId, academicYear, term])
}

model Payment {
  id                   String        @id @default(uuid())
  studentId            String
  academicYear         String
  term                 String?
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  referenceNumber      String?
  receiptNumber        String        @unique
  fedapayTransactionId Int?          @unique
  notchpayReference    String?       @unique
  paymentDate          DateTime
  notes                String?

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentPlan {
  id           String   @id @default(uuid())
  studentId    String
  institutionId String
  academicYear String
  totalAmount  Decimal  @db.Decimal(12, 2)
  notes        String?
  createdById  String

  student      Student     @relation(fields: [studentId], references: [id])
  institution  Institution @relation(fields: [institutionId], references: [id])
  createdBy    User        @relation("PaymentPlanCreator", fields: [createdById], references: [id])
  instalments  PaymentPlanInstalment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentPlanInstalment {
  id            String   @id @default(uuid())
  planId        String
  dueDate       DateTime
  amount        Decimal  @db.Decimal(12, 2)
  paidAt        DateTime?
  paidAmount    Decimal? @db.Decimal(12, 2)
  notes         String?

  plan PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentIntent {
  id                      String  @id @default(uuid())
  fedapayId               Int?    @unique
  notchpayReference       String? @unique
  cinetpayTransactionId   String? @unique
  studentId               String
  institutionId           String
  academicYear            String
  term                    String?
  amount                  Decimal @db.Decimal(12, 2)
  parentUserId            String
  status                  String  @default("PENDING")

  student     Student     @relation(fields: [studentId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id                String              @id @default(uuid())
  reportCardId      String?
  studentId         String?
  recipientUserId   String
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  heldReason        String?
  isRead            Boolean             @default(false)
  attemptCount      Int                 @default(0)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  providerMessageId String?
  errorMessage      String?

  reportCard ReportCard? @relation(fields: [reportCardId], references: [id])
  student    Student?    @relation(fields: [studentId], references: [id])
  recipient  User        @relation(fields: [recipientUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsappVerification {
  id          String    @id @default(uuid())
  userId      String
  phoneNumber String
  otpCode     String
  expiresAt   DateTime
  verifiedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model SubjectHoursLog {
  id           String  @id @default(uuid())
  subjectId    String
  classId      String
  academicYear String
  termNumber   Int
  termName     String?

  heuresPrevues    Int? // Heures de cours prévues
  heuresEffectuees Int? // Heures effectivement dispensées
  absences         Int? // Total absences élèves (demi-journées)
  retards          Int? // Total retards élèves
  notes            String? // Observations libres du professeur

  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, classId, academicYear, termNumber])
}

model TimetableSlot {
  id            String    @id @default(uuid())
  classId       String
  subjectId     String
  teacherId     String?
  institutionId String
  academicYear  String
  dayOfWeek     DayOfWeek
  startTime     String // "08:00"
  endTime       String // "09:00"
  room          String?

  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id])
  teacher     User?       @relation(fields: [teacherId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── LMS ──────────────────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String               @db.Text
  audience    AnnouncementAudience @default(ALL)
  classId     String?
  isPinned    Boolean              @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?

  authorId      String
  author        User        @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseMaterial {
  id           String       @id @default(uuid())
  title        String
  description  String?
  type         MaterialType
  url          String
  classId      String
  subjectId    String
  academicYear String
  termNumber   Int?

  uploadedById  String
  uploadedBy    User        @relation("MaterialUploader", fields: [uploadedById], references: [id])
  class         Class       @relation(fields: [classId], references: [id])
  subject       Subject     @relation(fields: [subjectId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id            String           @id @default(uuid())
  title         String
  instructions  String?          @db.Text
  dueDate       DateTime?
  maxScore      Float            @default(20)
  status        AssignmentStatus @default(DRAFT)
  attachmentUrl String?
  classId       String
  subjectId     String
  academicYear  String
  termNumber    Int?

  createdById   String?
  createdBy     User?                  @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  class         Class                  @relation(fields: [classId], references: [id])
  subject       Subject                @relation(fields: [subjectId], references: [id])
  submissions   AssignmentSubmission[]
  institutionId String
  institution   Institution            @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssignmentSubmission {
  id            String           @id @default(uuid())
  assignmentId  String
  studentId     String
  content       String?          @db.Text
  attachmentUrl String?
  status        SubmissionStatus @default(SUBMITTED)
  score         Float?
  feedback      String?          @db.Text
  submittedAt   DateTime         @default(now())
  gradedAt      DateTime?
  gradedById    String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id])
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
}

model Quiz {
  id              String     @id @default(uuid())
  title           String
  description     String?
  attachmentUrl   String?
  status          QuizStatus @default(DRAFT)
  durationMinutes Int?
  maxAttempts     Int        @default(1)
  openAt          DateTime?
  closeAt         DateTime?
  showResults     Boolean    @default(true)
  classId         String
  subjectId       String
  academicYear    String
  termNumber      Int?

  createdById   String?
  createdBy     User?          @relation("QuizCreator", fields: [createdById], references: [id], onDelete: SetNull)
  class         Class          @relation(fields: [classId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  questions     QuizQuestion[]
  attempts      QuizAttempt[]
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id     String       @id @default(uuid())
  quizId String
  text   String       @db.Text
  type   QuestionType
  points Float        @default(1)
  order  Int

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quizId, order])
}

model QuizOption {
  id         String  @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@unique([questionId, order])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?
  maxScore    Float?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id])
  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  isCorrect        Boolean?
  pointsEarned     Float?

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id])
  selectedOption QuizOption?  @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
}

// ─── Mock / blanc exams ───────────────────────────────────────────────────────

enum MockExamType {
  BLANC
  CEPE
  BEPC
  BAC1
  BAC2
}

enum MockExamStatus {
  DRAFT
  PUBLISHED
}

model MockExam {
  id            String         @id @default(uuid())
  institutionId String
  classId       String
  academicYear  String
  examType      MockExamType   @default(BLANC)
  label         String
  examDate      DateTime?
  examEndDate   DateTime?
  status        MockExamStatus @default(DRAFT)
  createdById   String?

  institution   Institution            @relation(fields: [institutionId], references: [id])
  class         Class                  @relation(fields: [classId], references: [id])
  createdBy     User?                  @relation("MockExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  grades        MockExamGrade[]
  subjectFiches MockExamSubjectFiche[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([classId])
}

model MockExamGrade {
  id          String @id @default(uuid())
  mockExamId  String
  studentId   String
  subjectId   String
  score       Float?
  coefficient Int    @default(1)

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id])
  subject  Subject  @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mockExamId, studentId, subjectId])
  @@index([mockExamId])
}

model MockExamSubjectFiche {
  id           String    @id @default(uuid())
  mockExamId   String
  subjectId    String
  signedAt     DateTime?
  signedByName String?
  signedById   String?

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id])
  signedBy User?    @relation("MockExamFicheSigner", fields: [signedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mockExamId, subjectId])
}

// ─── School as a Database — Records Modules ───────────────────────────────

model Attendance {
  id            String           @id @default(uuid())
  studentId     String
  classId       String
  subjectId     String?
  institutionId String
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  note          String?
  recordedBy    String?

  student     Student     @relation(fields: [studentId], references: [id])
  class       Class       @relation(fields: [classId], references: [id])
  subject     Subject?    @relation(fields: [subjectId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model SchoolDocument {
  id            String           @id @default(uuid())
  institutionId String
  title         String
  category      DocumentCategory @default(OTHER)
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  description   String?
  uploadedById  String?
  isPublic      Boolean          @default(false)

  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DocumentCategory {
  CIRCULAR
  REPORT
  CONTRACT
  SCHEDULE
  FINANCIAL
  EXAM
  STAFF
  STUDENT
  OTHER
}

model StaffProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  institutionId         String
  staffNumber           String?
  employmentDate        DateTime?
  contractType          String?
  qualification         String?
  specialization        String?
  experienceYears       Int?
  address               String?
  city                  String?
  nationality           String?
  nationalId            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?   @db.Text
  isActive              Boolean   @default(true)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id            String            @id @default(uuid())
  institutionId String
  title         String
  description   String?           @db.Text
  startDate     DateTime
  endDate       DateTime?
  allDay        Boolean           @default(true)
  type          CalendarEventType @default(EVENT)
  classId       String?
  color         String?
  isPublic      Boolean           @default(true)
  createdById   String?

  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DisciplinaryRecord {
  id             String           @id @default(uuid())
  studentId      String
  institutionId  String
  date           DateTime
  type           DisciplinaryType
  description    String           @db.Text
  sanction       String?
  sanctionStart  DateTime?
  sanctionEnd    DateTime?
  recordedByName String?
  recordedById   String?
  resolved       Boolean          @default(false)

  student Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
  MEETING
  SPORT
  CULTURAL
  DEADLINE
  PARENT_MEETING
  OTHER
}

enum DisciplinaryType {
  WARNING
  SUSPENSION
  EXCLUSION
  NOTE
  COMMENDATION
  OTHER
}

// ─── Incident Reports ────────────────────────────────────────────────────────

enum IncidentCategory {
  BULLYING
  HARASSMENT
  DISCRIMINATION
  TEACHER_MISCONDUCT
  STUDENT_MISCONDUCT
  CHEATING
  THEFT
  OTHER
}

enum IncidentStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model IncidentReport {
  id           String           @id @default(uuid())

  reportedById String
  reportedBy   User             @relation("IncidentReporter", fields: [reportedById], references: [id])

  accusedName  String
  accusedRole  String           // "Élève" | "Enseignant"

  category     IncidentCategory
  title        String
  description  String           @db.Text
  anonymous    Boolean          @default(false)

  status       IncidentStatus   @default(PENDING)
  adminNotes   String?          @db.Text

  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Alumni, Transfers, Inventory ─────────────────────────────────────────

enum TransferDirection {
  IN
  OUT
}

enum InventoryCategory {
  FURNITURE
  EQUIPMENT
  BOOK
  SPORT
  LAB
  IT
  OTHER
}

enum InventoryCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

model AlumniRecord {
  id                 String  @id @default(uuid())
  studentId          String  @unique
  institutionId      String
  graduationYear     Int
  lastClass          String?
  diplomaNumber      String?
  examType           String?
  examSession        String?
  examResult         String?
  nationalExamCenter String?
  furtherEducation   String?
  currentEmployer    String?
  contactEmail       String?
  contactPhone       String?
  notes              String? @db.Text

  student     Student     @relation(fields: [studentId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentTransfer {
  id              String            @id @default(uuid())
  studentId       String
  institutionId   String
  direction       TransferDirection
  otherSchool     String
  transferDate    DateTime          @db.Date
  academicYear    String?
  reason          String?
  documentUrl     String?
  notes           String?           @db.Text
  processedById   String?
  processedByName String?

  student     Student     @relation(fields: [studentId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id            String             @id @default(uuid())
  institutionId String
  name          String
  category      InventoryCategory  @default(OTHER)
  quantity      Int                @default(1)
  condition     InventoryCondition @default(GOOD)
  location      String?
  serialNumber  String?
  purchaseDate  DateTime?          @db.Date
  purchaseValue Float?
  supplier      String?
  notes         String?
  isActive      Boolean            @default(true)

  institution Institution   @relation(fields: [institutionId], references: [id])
  loans       LibraryLoan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── National Exam Results, Library, Health Records ──────────────────────────

enum NationalExamType {
  CEPD
  BEPC
  BAC
  BTS
  CAP
  OTHER
}

enum NationalExamResultStatus {
  ADMIS
  AJOURNE
  ABSENT
  ELIMINE
}

model NationalExamResult {
  id                 String                   @id @default(uuid())
  institutionId      String
  studentId          String
  examType           NationalExamType
  session            String
  academicYear       String
  registrationNumber String?
  center             String?
  series             String?
  result             NationalExamResultStatus
  mention            String?
  totalScore         Float?
  notes              String?

  student     Student     @relation(fields: [studentId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examType, session])
}

model LibraryLoan {
  id            String    @id @default(uuid())
  institutionId String
  itemId        String
  studentId     String?
  borrowerName  String?
  borrowerId    String?
  loanDate      DateTime  @db.Date
  dueDate       DateTime  @db.Date
  returnDate    DateTime? @db.Date
  isReturned    Boolean   @default(false)
  conditionOut  String?
  conditionIn   String?
  notes         String?
  issuedByName  String?
  issuedById    String?

  institution Institution   @relation(fields: [institutionId], references: [id])
  item        InventoryItem @relation(fields: [itemId], references: [id])
  student     Student?      @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HealthVisitType {
  CONSULTATION
  ACCIDENT
  VACCINATION
  DRESSING
  EVACUATION
  OTHER
}

model HealthRecord {
  id                 String          @id @default(uuid())
  institutionId      String
  studentId          String
  date               DateTime        @db.Date
  visitType          HealthVisitType @default(CONSULTATION)
  complaint          String?
  diagnosis          String?
  treatment          String?
  referredToHospital Boolean         @default(false)
  hospital           String?
  attendedByName     String?
  attendedById       String?
  notes              String?         @db.Text

  student     Student     @relation(fields: [studentId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Platform Subscriptions ───────────────────────────────────────────────────

model SubscriptionPayment {
  id            String           @id @default(uuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id])
  plan          String           // 'MONTHLY' | 'ANNUAL' (billing period)
  tier          SubscriptionTier? // auto-detected from student count at payment time
  amount        Int              // in XOF
  currency      String           @default("XOF")
  method        SubPaymentMethod
  status        SubPaymentStatus @default(PENDING_REVIEW)

  // MoMo manual fields
  momoPhone     String?          // school's phone number used to pay
  momoReference String?          // transaction ID from the operator
  momoOperator  String?          // TMONEY | FLOOZ | MOOV

  // Notchpay fields
  notchpayRef   String?          @unique
  notchpayUrl   String?

  // Review
  approvedById  String?
  approvedAt    DateTime?
  rejectedReason String?
  monthsGranted Int              @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Purchases ───────────────────────────────────────────────────────────────

model Purchase {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  date          DateTime    @db.Date
  itemName      String
  model         String?
  price         Decimal     @db.Decimal(12, 2)
  notes         String?
  recordedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
